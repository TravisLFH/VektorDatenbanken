# Qdrant-Verbindung
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_TIMEOUT=5
# QDRANT_API_KEY=
QDRANT_COLLECTION=space_objects

# Embedding-Modell und fachliche Limits
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
MAX_NAME_LENGTH=120
MAX_DESCRIPTION_LENGTH=2000
DEFAULT_SEARCH_LIMIT=5
MAX_SEARCH_LIMIT=50
